{
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm install)",
      "Bash(npx kill-port:*)",
      "Bash(taskkill:*)",
      "Bash(node scripts/seed.js:*)",
      "Skill(run)",
      "Skill(run:*)",
      "PowerShell(Get-Process -Name node -ErrorAction SilentlyContinue)",
      "PowerShell(Get-NetTCPConnection -LocalPort 3000 -ErrorAction SilentlyContinue)",
      "PowerShell(npm run dev)",
      "PowerShell($r = Invoke-WebRequest -Uri http://localhost:3000 -UseBasicParsing; \"Status: $\\($r.StatusCode\\)\"; $r.Content.Substring\\(0, [Math]::Min\\(500, $r.Content.Length\\)\\))",
      "PowerShell(Get-ChildItem -Recurse -Depth 2 -Directory | Where-Object { $_.FullName -notmatch 'node_modules|\\\\.next|\\\\.git' } | Select-Object -ExpandProperty FullName)",
      "PowerShell(npm run lint 2>&1)",
      "Bash(git config *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)",
      "Bash(npx tsc *)",
      "Bash(npx next *)"
    ]
  }
}
